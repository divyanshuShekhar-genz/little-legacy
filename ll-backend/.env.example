NODE_ENV=development
PORT=4000
# PostgreSQL user/database created in README → Quick start (step 1)
DATABASE_URL=postgresql://little_legacy:little_legacy@localhost:5432/little_legacy?schema=public
# Use a long random string outside local development.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Session length when "Remember me" is ticked on the login page.
JWT_REMEMBER_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# First Super Admin, created by the base seed (prisma/seeds/base.ts).
# SEED_SUPER_ADMIN_PASSWORD is required when NODE_ENV=production.
SEED_SUPER_ADMIN_EMAIL=owner@littlelegacy.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# File uploads. 'local' stores files on disk (development). Cloud storage is added as another driver.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads
