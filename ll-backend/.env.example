NODE_ENV=development
PORT=4000
# PostgreSQL user/database created in README → Quick start (step 1)
DATABASE_URL=postgresql://little_legacy:little_legacy@localhost:5432/little_legacy?schema=public
# Use a long random string outside local development.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
# Session length when "Remember me" is ticked on the login page.
JWT_REMEMBER_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# First Super Admin, created by the base seed (prisma/seeds/base.ts).
# SEED_SUPER_ADMIN_PASSWORD is required when NODE_ENV=production.
SEED_SUPER_ADMIN_EMAIL=owner@littlelegacy.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
# Parent-app password of the demo families (meera / kunal / priya @example.com), demo seed only.
SEED_DEMO_PARENT_PASSWORD=ChangeMe123!

# File uploads. 'local' stores files on disk (development). Cloud storage is added as another driver.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_PATH=/uploads

# Parent app (docs/PARENT_API.md). Use a different long random string from JWT_SECRET; required in production.
PARENT_JWT_SECRET=change-me-parent-app-secret
PARENT_ACCESS_EXPIRES_IN=1h
PARENT_REFRESH_DAYS=60
# Google sign-in: the app's OAuth client IDs (iOS, Android, web), comma separated. Empty turns it off.
GOOGLE_CLIENT_IDS=
# Sign in with Apple: the app's bundle ID (and Services ID), comma separated. Empty turns it off.
APPLE_CLIENT_IDS=
# 'log' prints emails (password codes) to the server log. A real provider is added later.
EMAIL_DRIVER=log
